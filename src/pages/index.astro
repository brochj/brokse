        title: 'Planta VDI (Voz, Dados e Imagens)',
        icon: 'tabler:wifi',
        description:
          'Infraestrutura dos pontos de Internet e TV',
      },
      {
        title: 'Detalhamentos',
        icon: 'tabler:zoom',
        description:
          'Detalhes construtivos para facilitar a execução dos pontos e instalações.',
      },
    ]}
    image={{
      src: imgProjetoInfraestrutura,
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">INFRAESTRUTURA</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

