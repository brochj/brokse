  <!-- Steps Widget ****************** -->

  <Steps
    title="Quais serão as etapas"
    items={[
      {
        title: 'Converse conosco',
        description:
          'Conte um pouco sobre sua casa e o que você precisa.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Análise e orçamento',
        description:
          'Analisamos seu projeto e enviamos uma proposta sob medida.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Projeto preliminar',
        description:
          'Definimos os pontos elétricos e alinhamos tudo com você.',
        icon: 'tabler:number-3',
      },
      {
        title: 'Projeto executivo',
        description:
          'Detalhamos a instalação, com eletrodutos, fiação e circuitos.',
        icon: 'tabler:number-4',
      },
      {
        title: 'Compatibilização',
        description:
          'Conferimos o projeto junto à arquitetura para evitar conflitos.',
        icon: 'tabler:number-5',
      },
      {
        title: 'Concluído!',
        description:
          'Você recebe o projeto completo, pronto para ser utilizado.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: imgQDC3D,
      alt: 'QDC 3D',
    }}
  />
  
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar orçamento',
        href: WHATSAPP_URL,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Gostou do que viu?
    </Fragment>

    <Fragment slot="subtitle">
      Fale conosco e descubra como podemos desenvolver o projeto elétrico da sua residência.
    </Fragment>
  </CallToAction>
 

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Dúvidas frequentes"
    subtitle=""
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Por que contratar um projeto elétrico?',
        description:
          'O projeto organiza toda a instalação elétrica, define os circuitos, dimensionamentos e pontos, ajudando a evitar improvisos e problemas durante a obra.',
      },
      {
        title: 'O que preciso enviar para começar?',
        description:
          'Precisamos principalmente da planta arquitetônica e das informações sobre a residência e suas necessidades.',
      },
      {
        title: 'O projeto é feito em Revit?',
        description:
          'Sim. Desenvolvemos o projeto em Revit, permitindo uma representação mais detalhada e organizada da instalação elétrica.',
      },
      {
        title: 'Vocês fazem o projeto a partir da planta arquitetônica?',
        description:
          'Sim. A partir da arquitetura, definimos os pontos elétricos e desenvolvemos todo o projeto da instalação.',
      },
      {
        title: 'Posso acompanhar e solicitar alterações no projeto?',
        description:
          'Sim. O projeto preliminar é apresentado para alinharmos os pontos e necessidades antes do desenvolvimento final.',
      },
      {
        title: 'O que recebo ao final do projeto?',
        description:
          'Você recebe as pranchas e documentos que fazem parte do projeto, organizados e prontos para utilização na obra.',
      },
      {
        title: 'Quanto custa um projeto elétrico residencial?',
        description:
          'O valor depende do tamanho e das características da residência. Entre em contato para receber um orçamento personalizado.',
      },
      {
        title: 'Quanto tempo leva para ficar pronto?',
        description:
          'O prazo depende do tamanho e da complexidade do projeto. Informamos o prazo junto com a proposta.',
      },
    ]}
  />



