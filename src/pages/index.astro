---
import Layout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Steps from '~/components/widgets/Steps.astro';

import Steps2 from '~/components/widgets/Steps2.astro';

import { EMAIL, INSTAGRAM_USER, WHATSAPP_URL } from '~/config/constants';
import { getPermalink } from '~/utils/permalinks';


const imgProjetoInfraestrutura = '~/assets/images/projeto-residencial/infra.png'
const imgPlantaFiacao = '~/assets/images/projeto-residencial/planta-fiacao.png'
// const imgDiagramaUnifilar = '~/assets/images/projeto-residencial/diagrama-unifilar.png'
// const imgPlantaVdi = '~/assets/images/projeto-residencial/planta-vdi.png'
// const imgQuantitativo = '~/assets/images/projeto-residencial/quantitativo.png'
// const imgQuadroDeCargas = '~/assets/images/projeto-residencial/quadro-de-cargas.png'
const imgQDC3D = '~/assets/images/projeto-residencial/qdc-3d.png'

const metadata = {
  title: 'BROK — Soluções Elétricas',
  ignoreTitleTemplate: true,
};
