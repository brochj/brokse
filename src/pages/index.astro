  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Falar pelo WhatsApp',
        href: WHATSAPP_URL,
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { 
        text: 'Ver exemplo de um projeto', 
        href: getPermalink('/servicos/portfolio')
      },
      // { text: 'Entenda o que é um projeto elétrico', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/man-repairer-making-electricity-project-in-house-repairs-planning-drawing.webp',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Projetos Elétricos Residenciais</span>
    </Fragment>
  
  
    <Fragment slot="subtitle">
      
      Será um prazer entender seu objetivo e preparar uma proposta para você.
    </Fragment>
  </Hero>

